+fn public_fork_history_from_snapshot(
+    snapshot: ForkSnapshot,
+    history: InitialHistory,
+    interrupted_marker: InterruptedTurnHistoryMarker,
+) -> InitialHistory {
+    if snapshot != ForkSnapshot::Interrupted {
+        return fork_history_from_snapshot(snapshot, history, interrupted_marker);
+    }
+    let state = snapshot_turn_state(&history);
+    if !state.ends_mid_turn {
+        return fork_history_from_snapshot(snapshot, history, interrupted_marker);
+    }
+    let inherited_items = history.get_rollout_items();
+    let inherited_len = inherited_items.len();
+    let active_start = state.active_turn_start_index.unwrap_or_else(|| {
+        truncation::user_message_positions_in_rollout(inherited_items)
+            .last()
+            .copied()
+            .unwrap_or(inherited_len)
+    });
+    let active_items = &inherited_items[active_start..];
+    let mut output_call_ids = active_items
+        .iter()
+        .filter_map(|item| match item {
+            RolloutItem::ResponseItem(envelope) => match &envelope.item {
+                ResponseItem::CustomToolCallOutput { call_id, .. } => Some(call_id.as_str()),
+                _ => None,
+            },
+            _ => None,
+        })
+        .collect::<HashSet<_>>();
+    let pending_outputs = active_items
+        .iter()
+        .filter_map(|item| match item {
+            RolloutItem::ResponseItem(envelope) => match &envelope.item {
+                ResponseItem::CustomToolCall { id, call_id, .. }
+                    if output_call_ids.insert(call_id.as_str()) =>
+                {
+                    Some(RolloutItem::ResponseItem(
+                        ResponseItem::CustomToolCallOutput {
+                            id: crate::context_manager::synthetic_output_id("ctco", id.as_deref()),
+                            call_id: call_id.clone(),
+                            name: None,
+                            output: FunctionCallOutputPayload::from_text("aborted".to_string()),
+                            internal_chat_message_metadata_passthrough: None,
+                        }
+                        .into(),
+                    ))
+                }
+                _ => None,
+            },
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    let mut fork = fork_history_from_snapshot(snapshot, history, interrupted_marker);
+    if let InitialHistory::Forked(items) = &mut fork {
+        // A live parent's pending tool continues there, but is interrupted in this child.
+        // Append child-only outputs before the interrupt boundary, preserving the copied
+        // prefix (including reference-backed history), IDs, authorization and usage records.
+        // Native-agent forks use their own inherited-envelope normalization instead.
+        items.splice(inherited_len..inherited_len, pending_outputs);
+    }
+    fork
+}
