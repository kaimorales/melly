+#[test]
+fn public_interrupted_fork_pairs_pending_custom_calls_without_changing_parent() {
+    use crate::context_manager::ContextManager;
+    use codex_protocol::SessionId;
+    use codex_protocol::models::FunctionCallOutputPayload;
+    use codex_protocol::protocol::TokenUsageRecord;
+
+    let parent_id = ThreadId::new();
+    let custom_call = |suffix: &str| ResponseItem::CustomToolCall {
+        encrypted_content: None,
+        id: Some(ResponseItemId::with_suffix("ctc", suffix)),
+        status: None,
+        call_id: format!("call-{suffix}"),
+        name: "exec".to_string(),
+        namespace: Some("functions".to_string()),
+        input: "await tools.melly_agents_spawn({});".to_string(),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let completed_output = ResponseItem::CustomToolCallOutput {
+        id: Some(ResponseItemId::with_suffix("ctco", "completed")),
+        call_id: "call-completed".to_string(),
+        name: None,
+        output: FunctionCallOutputPayload::from_text("completed result".to_string()),
+        internal_chat_message_metadata_passthrough: None,
+    };
+    let parent_items = Arc::new(vec![
+        RolloutItem::EventMsg(EventMsg::TurnStarted(TurnStartedEvent {
+            turn_attribution: None,
+            turn_id: "parent-turn".to_string(),
+            root_turn_id: None,
+            trace_id: None,
+            started_at: None,
+            model_context_window: None,
+            collaboration_mode_kind: Default::default(),
+        })),
+        RolloutItem::ResponseItem(user_msg("delegate from this live turn").into()),
+        RolloutItem::ResponseItem(custom_call("completed").into()),
+        RolloutItem::ResponseItem(completed_output.clone().into()),
+        RolloutItem::ResponseItem(custom_call("pending").into()),
+        RolloutItem::TokenUsageRecord(TokenUsageRecord {
+            thread_id: parent_id,
+            turn_id: "parent-turn".to_string(),
+            session_id: SessionId::from(parent_id),
+            root_turn_id: "parent-turn".to_string(),
+            response_id: "parent-response".to_string(),
+            usage: TokenUsage {
+                input_tokens: 100,
+                output_tokens: 10,
+                total_tokens: 110,
+                ..Default::default()
+            },
+            turn_token_usage: TokenUsage::default(),
+            thread_token_usage: TokenUsage::default(),
+        }),
+    ]);
+    let original = serde_json::to_value(parent_items.as_ref()).expect("serialize parent");
+    let source = InitialHistory::Resumed(ResumedHistory {
+        history_revision: None,
+        conversation_id: parent_id,
+        history: Arc::clone(&parent_items),
+        rollout_path: None,
+    });
+    let fork = public_fork_history_from_snapshot(
+        ForkSnapshot::Interrupted,
+        source.clone(),
+        InterruptedTurnHistoryMarker::ContextualUser,
+    );
+    let mut context = ContextManager::new();
+    context.replace_annotated(
+        fork.get_rollout_items()
+            .iter()
+            .filter_map(|item| match item {
+                RolloutItem::ResponseItem(envelope) => Some(envelope.clone()),
+                _ => None,
+            })
+            .collect(),
+    );
+    // The previous implementation panics here on the pending code-mode call.
+    context.normalize_history(&[]);
+    let outputs = context
+        .raw_items()
+        .filter_map(|item| match item {
+            ResponseItem::CustomToolCallOutput { call_id, .. } => Some((call_id.as_str(), item)),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(outputs.len(), 2);
+    assert_eq!(outputs[0].1, &completed_output);
+    assert_eq!(outputs[1].0, "call-pending");
+    let mut inherited_call = codex_history::ResponseItemEnvelope::new(custom_call("pending"));
+    inherited_call
+        .metadata
+        .get_or_insert_default()
+        .inherited_user_message = true;
+    let mut native_projection = ContextManager::new();
+    native_projection.replace_annotated(vec![inherited_call]);
+    native_projection.normalize_history(&[]);
+    // Match the established normalization payload and deterministic output identity.
+    assert_eq!(Some(outputs[1].1), native_projection.raw_items().last());
+    let appended = &fork.get_rollout_items()[parent_items.len()];
+    let RolloutItem::ResponseItem(appended) = appended else {
+        panic!("child output suffix")
+    };
+    assert_eq!(&appended.item, outputs[1].1);
+    assert_eq!(
+        serde_json::to_value(&fork.get_rollout_items()[..parent_items.len()]).unwrap(),
+        original
+    );
+    assert_eq!(
+        serde_json::to_value(parent_items.as_ref()).unwrap(),
+        original
+    );
+    assert!(!snapshot_turn_state(&fork).ends_mid_turn);
+    let replayed_fork = public_fork_history_from_snapshot(
+        ForkSnapshot::Interrupted,
+        source.clone(),
+        InterruptedTurnHistoryMarker::ContextualUser,
+    );
+    assert_eq!(
+        serde_json::to_value(&replayed_fork.get_rollout_items()[parent_items.len()]).unwrap(),
+        serde_json::to_value(&fork.get_rollout_items()[parent_items.len()]).unwrap(),
+    );
+    let completed_fork = public_fork_history_from_snapshot(
+        ForkSnapshot::Interrupted,
+        fork.clone(),
+        InterruptedTurnHistoryMarker::ContextualUser,
+    );
+    assert_eq!(
+        serde_json::to_value(completed_fork.get_rollout_items()).unwrap(),
+        serde_json::to_value(fork.get_rollout_items()).unwrap()
+    );
+    let truncated = public_fork_history_from_snapshot(
+        ForkSnapshot::TruncateBeforeNthUserMessage(usize::MAX),
+        source.clone(),
+        InterruptedTurnHistoryMarker::ContextualUser,
+    );
+    let unchanged_truncation = fork_history_from_snapshot(
+        ForkSnapshot::TruncateBeforeNthUserMessage(usize::MAX),
+        source,
+        InterruptedTurnHistoryMarker::ContextualUser,
+    );
+    assert_eq!(
+        serde_json::to_value(truncated.get_rollout_items()).unwrap(),
+        serde_json::to_value(unchanged_truncation.get_rollout_items()).unwrap()
+    );
+}
